# Copy to .env and fill in. Everything left empty runs in test mode.
PORT=3000
# The public address of the app, without a trailing slash (used in sign-in links and payment returns)
BASE_URL=http://localhost:3000
# A long random value; keeps people signed in across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=
DB_PATH=triti-matia.db

# Claude API (platform.claude.com). Empty = test mode with a sample answer.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Stripe (dashboard.stripe.com). Empty = simulated payments. Use sk_test_… keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PRO=
# Set to 1 once Stripe Tax is set up, so VAT is added per country
STRIPE_AUTOMATIC_TAX=0

# Full CCR registry including private entries (kept off the repository). Empty = ../ccr/registry.json
CCR_REGISTRY_PATH=
